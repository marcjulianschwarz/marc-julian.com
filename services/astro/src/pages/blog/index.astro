---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostCard from "../../components/PostCard.astro";
import TagChip from "../../components/TagChip.astro";
import { blogConfig } from "@config";

const allPosts = await getCollection("blog", (e) => !e.data["blog-skip"]);

allPosts.sort((a, b) => {
  const da = a.data["blog-published"]?.getTime() ?? 0;
  const db = b.data["blog-published"]?.getTime() ?? 0;
  return db - da;
});

const posts = allPosts.filter((p) => !p.data["blog-archived"]);
const archived = allPosts.filter((p) => p.data["blog-archived"]);

const tagSet = new Set<string>();
for (const post of allPosts) {
  for (const tag of post.data["blog-tags"]) tagSet.add(tag);
}
const tags = Array.from(tagSet).sort();

function isYear(tag: string) { return /^\d{4}$/.test(tag); }
function tagSlug(tag: string) { return tag.toLowerCase().replace(/ /g, "-"); }
---

<BlogLayout>
  <header class="mb-12">
    <a href="/" class="text-xs text-[#abb0b6] hover:text-[#575f66] transition-colors" style="font-family: 'JetBrains Mono', monospace;">
      ← back
    </a>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight" style="font-family: 'Lora', serif; color: #575f66;">
      <span style="color: #f29718;">MJ's</span> Blog
    </h1>
  </header>

  <section class="mb-10">
    <p class="text-xs text-[#abb0b6] uppercase tracking-widest mb-3" style="font-family: 'JetBrains Mono', monospace;">Tags</p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <TagChip
          name={tag}
          href={`${blogConfig.tagsBase}/${tagSlug(tag)}`}
          year={isYear(tag)}
        />
      ))}
    </div>
  </section>

  <section class="mb-12">
    <p class="text-xs text-[#abb0b6] uppercase tracking-widest mb-1" style="font-family: 'JetBrains Mono', monospace;">Posts</p>
    <div>
      {posts.map((post) => (
        <PostCard
          title={post.data["blog-title"]}
          subtitle={post.data["blog-subtitle"]}
          date={post.data["blog-published"]}
          tags={post.data["blog-tags"]}
          href={`${blogConfig.postsBase}/${post.id}`}
        />
      ))}
    </div>
  </section>

  {archived.length > 0 && (
    <section>
      <p class="text-xs text-[#abb0b6] uppercase tracking-widest mb-1" style="font-family: 'JetBrains Mono', monospace;">Archived</p>
      <div>
        {archived.map((post) => (
          <PostCard
            title={post.data["blog-title"]}
            subtitle={post.data["blog-subtitle"]}
            date={post.data["blog-published"]}
            tags={post.data["blog-tags"]}
            href={`${blogConfig.postsBase}/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}
</BlogLayout>
