---
import { getCollection } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { blogConfig } from "@config";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (e) => !e.data["blog-skip"]);

  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data["blog-tags"]) {
      const slug = tag.toLowerCase().replace(/ /g, "-");
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, tagPosts]) => ({
    params: { tag: slug },
    props: {
      tagName: tagPosts[0].data["blog-tags"].find(
        (t) => t.toLowerCase().replace(/ /g, "-") === slug
      ) ?? slug,
      posts: tagPosts.sort((a, b) => {
        const da = a.data["blog-published"]?.getTime() ?? 0;
        const db = b.data["blog-published"]?.getTime() ?? 0;
        return db - da;
      }),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BlogLayout title={tagName}>
  <nav class="mb-8">
    <a href={blogConfig.blogBase} class="text-sm text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 no-underline transition-colors">
      ← Back
    </a>
  </nav>

  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-1">Tag</p>
    <h1 class="text-2xl font-bold tracking-tight">{tagName}</h1>
    <p class="text-sm text-neutral-400 mt-1">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
  </header>

  <div class="flex flex-col gap-3">
    {posts.map((post) => (
      <PostCard
        title={post.data["blog-title"]}
        subtitle={post.data["blog-subtitle"]}
        date={post.data["blog-published"]}
        tags={post.data["blog-tags"]}
        href={`${blogConfig.postsBase}/${post.id}`}
      />
    ))}
  </div>
</BlogLayout>
