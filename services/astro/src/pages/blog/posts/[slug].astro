---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import TagChip from "../../../components/TagChip.astro";
import { blogConfig } from "@config";
import { tagsForPost, isYear, tagSlug } from "@/lib/tags";

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection("blog", (e) => {
    if (e.data["blog-skip"]) return false;
    const pub = e.data["blog-published"];
    if (pub && pub > now) return false;
    return true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const data = post.data;
const title = data["blog-title"];
const subtitle = data["blog-subtitle"];
const date = data["blog-published"];
const tags = tagsForPost(data["blog-tags"] ?? [], date);

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout title={title}>
  <nav class="mb-10">
    <a
      href={blogConfig.blogBase}
      class="back-link text-xs"
      style="font-family: 'JetBrains Mono', monospace;"
    >
      ← back
    </a>
  </nav>

  <article>
    <header class="mb-10 pb-8 border-b" style="border-color: var(--color-border);">
      <h1 class="text-2xl font-semibold leading-snug mb-2" style="font-family: 'Inter', sans-serif; color: var(--color-text);">{title}</h1>
      {subtitle && (
        <p class="text-base italic mb-3" style="font-family: 'Inter', sans-serif; color: var(--color-muted);">{subtitle}</p>
      )}
      {date && (
        <time
          datetime={date.toISOString()}
          class="text-xs"
          style="font-family: 'JetBrains Mono', monospace; color: var(--color-muted);"
        >
          {formattedDate}
        </time>
      )}
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {tags.map((tag) => (
            <TagChip
              name={tag}
              href={`${blogConfig.tagsBase}/${tagSlug(tag)}`}
              year={isYear(tag)}
            />
          ))}
        </div>
      )}
    </header>

    <div class="prose max-w-none">
      <Content />
    </div>
  </article>
</BlogLayout>

<style>
  .back-link {
    color: var(--color-muted);
  }
  .back-link:hover {
    color: var(--color-text);
  }

  .prose {
    color: var(--color-text);
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--color-accent);
    font-family: 'Inter', sans-serif;
  }
  .prose :global(h1),
  .prose :global(h2) {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
  }
  .prose :global(a) {
    color: var(--color-accent);
  }
  .prose :global(a:hover) {
    opacity: 0.8;
  }
  .prose :global(strong) {
    color: var(--color-text);
  }
  .prose :global(:not(pre) > code) {
    background-color: #ebebeb;
    color: var(--color-text);
    padding: 0.15em 0.35em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .prose :global(:not(pre) > code::before),
  .prose :global(:not(pre) > code::after) {
    content: none;
  }
  @media (prefers-color-scheme: dark) {
    .prose :global(:not(pre) > code) {
      background-color: #1e2530;
    }
  }
  .prose :global(pre) {
    border-radius: 1rem;
    overflow-x: auto;
  }
  .prose :global(blockquote) {
    border-left-color: var(--color-border);
    color: var(--color-muted);
  }
  .prose :global(img) {
    border-radius: 1rem;
  }
  .prose :global(hr) {
    border-color: var(--color-border);
  }
  .prose :global(thead) {
    border-bottom-color: var(--color-border);
  }
  .prose :global(tbody tr) {
    border-bottom-color: var(--color-border);
  }
</style>
