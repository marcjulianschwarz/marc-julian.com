---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import TagChip from "../../../components/TagChip.astro";
import { blogConfig } from "@config";
import { tagsForPost, isYear, tagSlug } from "@/lib/tags";

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection("blog", (e) => {
    if (e.data["blog-skip"]) return false;
    const pub = e.data["blog-published"];
    if (pub && pub > now) return false;
    return true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const data = post.data;
const title = data["blog-title"];
const subtitle = data["blog-subtitle"];
const date = data["blog-published"];
const tags = tagsForPost(data["blog-tags"] ?? [], date);

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout title={title}>
  <nav class="mb-10">
    <a
      href={blogConfig.blogBase}
      class="text-xs text-[#abb0b6] hover:text-[#575f66] transition-colors"
      style="font-family: 'JetBrains Mono', monospace;"
    >
      ← back
    </a>
  </nav>

  <article>
    <header class="mb-10 pb-8 border-b border-[#d9d8d8]">
      <h1 class="text-2xl font-semibold leading-snug mb-2" style="font-family: 'Lora', serif; color: #575f66;">{title}</h1>
      {subtitle && (
        <p class="text-base italic mb-3" style="font-family: 'Lora', serif; color: #abb0b6;">{subtitle}</p>
      )}
      {date && (
        <time
          datetime={date.toISOString()}
          class="text-xs text-[#abb0b6]"
          style="font-family: 'JetBrains Mono', monospace;"
        >
          {formattedDate}
        </time>
      )}
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {tags.map((tag) => (
            <TagChip
              name={tag}
              href={`${blogConfig.tagsBase}/${tagSlug(tag)}`}
              year={isYear(tag)}
            />
          ))}
        </div>
      )}
    </header>

    <div class="prose max-w-none" style="color: #575f66;">
      <Content />
    </div>
  </article>
</BlogLayout>
