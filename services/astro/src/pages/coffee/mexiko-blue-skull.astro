---
import BlogLayout from "../../layouts/BlogLayout.astro";
import CoffeeCard from "../../components/CoffeeCard.astro";

const specs = [
    { label: "Herkunft", value: "Mexiko" },
    { label: "Varietät", value: "100 % Arabica: Caturra, Bourbon, Geisha" },
    { label: "Verarbeitung", value: "gewaschen" },
    { label: "Anbauhöhe", value: "1.200 – 1.500 m" },
    { label: "Röstung", value: "Röstkaffee, ganze Bohnen" },
    { label: "Füllmenge", value: "250 g" },
    {
        label: "Zertifizierung",
        value: "Bio (DE-ÖKO-001, Nicht-EU-Landwirtschaft) & Fairtrade",
    },
];
---

<BlogLayout
    title="Mexiko Blue Skull"
    description="Mexiko Blue Skull — ein fröhlicher Bio- und Fairtrade-Espresso, inspiriert vom Día de los Muertos."
>
    <CoffeeCard
        title="Mexiko Blue Skull"
        roaster="Espressone GmbH, Cadolzburg"
        flavors={["Vollmilchschokolade", "Muskovado-Zucker", "Mandel"]}
        specs={specs}
    >
        <p>
            Fröhlich, bunt und laut. Das ist das Fest <strong
                >Día de los Muertos</strong
            > — das Fest der Toten, das traditionell in Mexico gefeiert wird.
            Angelehnt an dieses Fest ist dieser besonders fröhliche und bunte
            <strong>Bio Espresso Mexico Blue Scull</strong>. Mit seinem
            schokoladigen Aroma und Noten von Muskovado bringt dieser ein
            exklusives Geschmackserlebnis in die Kaffeetasse. Das Anbaugebiet
            befindet sich auf 1.200 – 1.500 Metern Höhe und wird unter
            Bio-Richtlinien bewirtschaftet.
        </p>
        <p slot="note">
            Hochlandkaffee: Fairtrade fördert bessere Arbeits- und
            Lebensbedingungen für zertifizierte Produzenten sowie den
            Umweltschutz. Dieser Kaffee wurde von Fairtrade-Produzenten
            angebaut, nach Fairtrade-Standards zertifiziert und gehandelt.
            Gesamtanteil 100 %. Der Kaffee wurde im traditionellen
            handwerklichen Verfahren unter Einhaltung der Qualitätsbestimmungen
            der Deutschen Röstergilde hergestellt.
        </p>
    </CoffeeCard>
</BlogLayout>
