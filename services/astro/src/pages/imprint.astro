---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="Imprint">
  <h1 class="text-2xl font-semibold mb-8" style="color: var(--color-text);">Imprint</h1>
  <a href="mailto:hi@marc-julian.de" class="accent-link mono-text">Send Email</a>
</BlogLayout>

<style>
  .accent-link {
    color: var(--color-accent);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }
  .accent-link:hover {
    opacity: 0.8;
  }
</style>
