---
import { getCollection } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";
import { blogConfig } from "@config";

const now = new Date();
const allPosts = await getCollection("blog", (e) => {
  if (e.data["blog-skip"]) return false;
  const pub = e.data["blog-published"];
  if (pub && pub > now) return false;
  return true;
});

allPosts.sort((a, b) => {
  const da = a.data["blog-published"]?.getTime() ?? 0;
  const db = b.data["blog-published"]?.getTime() ?? 0;
  return db - da;
});

const recentPosts = allPosts.filter((p) => !p.data["blog-archived"]).slice(0, 7);

function shortHash(id: string) {
  return id.replace(/[^a-zA-Z0-9]/g, "").slice(0, 7).toLowerCase().padEnd(7, "0");
}
