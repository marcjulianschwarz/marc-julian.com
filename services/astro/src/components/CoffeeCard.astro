---
interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  roaster: string;
  flavors?: string[];
  specs?: Spec[];
}

const { title, roaster, flavors = [], specs = [] } = Astro.props;
---

<article class="coffee-card">
  <h1 class="display-heading coffee-card-title">{title}</h1>

  {flavors.length > 0 && (
    <ul class="coffee-card-flavors">
      {flavors.map((flavor) => <li>{flavor}</li>)}
    </ul>
  )}

  <div class="coffee-card-body">
    <slot />
  </div>

  {specs.length > 0 && (
    <dl class="coffee-card-specs">
      {specs.map((spec) => (
        <div class="coffee-card-spec">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>
  )}

  <footer class="coffee-card-footer">
    <div class="coffee-card-note"><slot name="note" /></div>
    <span class="coffee-card-roaster">{roaster}</span>
  </footer>
</article>

<style>
  .coffee-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    font-family: "Inter", sans-serif;
  }

  .coffee-card-title {
    margin: 0;
    color: var(--color-accent);
  }

  .coffee-card-flavors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .coffee-card-flavors li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .coffee-card-body {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    line-height: 1.7;
    color: var(--color-text);
  }
  .coffee-card-body :global(strong) {
    font-weight: 600;
    color: var(--color-accent);
  }

  .coffee-card-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
  }
  @media (max-width: 479px) {
    .coffee-card-specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .coffee-card-spec dt {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .coffee-card-spec dd {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .coffee-card-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .coffee-card-note:empty {
    display: none;
  }
  .coffee-card-roaster {
    font-weight: 500;
    color: var(--color-text);
  }
</style>
