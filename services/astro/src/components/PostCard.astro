---
interface Props {
  title: string;
  subtitle?: string;
  date?: Date;
  tags: string[];
  href: string;
}

const { title, subtitle, date, href } = Astro.props;

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={href} class="post-card group block py-4 border-b no-underline" style="border-color: var(--color-border);">
  <div class="flex items-baseline justify-between gap-4">
    <span class="post-title text-base leading-snug">{title}</span>
    {date && (
      <time
        datetime={date.toISOString()}
        class="text-xs whitespace-nowrap shrink-0"
        style="font-family: 'JetBrains Mono', monospace; color: var(--color-muted);"
      >
        {formattedDate}
      </time>
    )}
  </div>
  {subtitle && <p class="text-base italic mt-0.5" style="font-family: 'Inter', sans-serif; color: var(--color-muted);">{subtitle}</p>}
</a>

<style>
  .post-title {
    color: var(--color-text);
  }
  .post-card:hover .post-title {
    color: var(--color-accent);
  }
</style>
