---
import TagChip from "./TagChip.astro";
import { blogConfig } from "@config";

interface Props {
  title: string;
  subtitle?: string;
  date?: Date;
  tags: string[];
  href: string;
}

const { title, subtitle, date, tags, href } = Astro.props;

function isYear(tag: string) { return /^\d{4}$/.test(tag); }
function tagSlug(tag: string) { return tag.toLowerCase().replace(/ /g, "-"); }

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={href}
  class="group block p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-all hover:shadow-sm no-underline"
>
  <div class="flex flex-col gap-2">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
          {title}
        </h2>
        {subtitle && (
          <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-0.5">{subtitle}</p>
        )}
      </div>
      {date && (
        <time
          datetime={date.toISOString()}
          class="text-xs text-neutral-400 dark:text-neutral-500 whitespace-nowrap pt-0.5 shrink-0"
        >
          {formattedDate}
        </time>
      )}
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <TagChip
            name={tag}
            href={`${blogConfig.tagsBase}/${tagSlug(tag)}`}
            year={isYear(tag)}
          />
        ))}
      </div>
    )}
  </div>
</a>
