---
interface Props {
  title: string;
  subtitle?: string;
  date?: Date;
  tags: string[];
  href: string;
}

const { title, subtitle, date, href } = Astro.props;

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={href} class="group block py-4 border-b border-[#d9d8d8] no-underline">
  <div class="flex items-baseline justify-between gap-4">
    <span class="text-[#575f66] group-hover:text-[#f29718] transition-colors leading-snug">{title}</span>
    {date && (
      <time
        datetime={date.toISOString()}
        class="text-xs text-[#abb0b6] whitespace-nowrap shrink-0"
        style="font-family: 'JetBrains Mono', monospace;"
      >
        {formattedDate}
      </time>
    )}
  </div>
  {subtitle && <p class="text-sm text-[#abb0b6] italic mt-0.5" style="font-family: 'Lora', serif;">{subtitle}</p>}
</a>
