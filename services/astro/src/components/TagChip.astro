---
interface Props {
  name: string;
  href: string;
  year?: boolean;
}

const { name, href, year = false } = Astro.props;
---

<a
  href={href}
  class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium no-underline transition-opacity hover:opacity-70 ${
    year
      ? "bg-neutral-200 text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300"
      : "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300"
  }`}
>
  {name}
</a>
